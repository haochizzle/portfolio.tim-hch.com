---
import Base from '../layouts/Base.astro';

// Distribution — view counts from YouTube API (2026-06-26). Channel @90secondstocrypto.
const distribution = [
  {
    name: 'Chainlink',
    handle: 'dHiHR9jeuF8',
    reach: '4.1K views',
    type: 'Featured · Meet the slept King of blockchains',
    accent: true,
    url: 'https://youtu.be/dHiHR9jeuF8',
  },
  {
    name: 'Fileverse',
    handle: 'Gu4y0SZNmoU',
    reach: '5.4K views',
    type: 'Why Fileverse is the Google Docs killer',
    url: 'https://youtu.be/Gu4y0SZNmoU',
  },
  {
    name: 'Keycard Shell',
    handle: 'HgXoI4jad-g',
    reach: '330 views',
    type: 'The ugliest crypto wallet — and why that matters',
    url: 'https://youtu.be/HgXoI4jad-g',
  },
];

const writing = [
  {
    pub: 'ChainSafe Systems · Medium',
    date: '2022',
    title: 'Introducing the Privacy Engineering Team',
    lede: 'A first look at the unit I was helping stand up — why privacy work belongs in protocol teams, not afterthoughts.',
    url: 'https://medium.com/chainsafe-systems',
  },
  {
    pub: 'The Capital · Medium',
    date: '2021',
    title: 'Forget the Money & Hype',
    lede: 'A piece I needed to write: the case for sticking with the builders when the cycle turns.',
    url: 'https://medium.com/the-capital',
  },
  {
    pub: 'Personal · Medium',
    date: '2023',
    title: 'Children of Orchid',
    lede: 'A long, strange essay I wrote about identity, openness, and what gets passed down. The most personal thing on this list by a wide margin.',
    url: 'https://medium.com/@haochizzle',
  },
  {
    pub: 'Forthcoming',
    date: '2026',
    title: 'The pitches I haven’t filed yet',
    lede: 'Three editorials in cold-DM limbo. One about why “DevRel is dead” is the wrong frame. One about the sovereignty stack. One I’m not ready to name.',
  },
];

const interviews = [
  {
    name: 'Jimmy',
    role: 'Independent developer',
    featured: true,
    id: 'OvMEl4L-0bY',
  },
  {
    name: 'Timofey',
    role: 'ChainSafe',
    id: 'SHXgT17J874',
  },
  {
    name: 'zy0n',
    role: 'Railgun',
    id: '8qhMECRarpE',
  },
  {
    name: 'Oskar',
    role: 'Ethereum Foundation · IPTF',
    id: 'p-cKWfAj6nI',
  },
  {
    name: 'Alan Scott',
    role: 'Railgun',
    id: 'N7i1wAnGOpI',
  },
  {
    name: 'Chris Blake',
    role: 'Independent researcher',
    id: '6KaxUw5YZe0',
  },
  {
    name: 'Phil Ngo',
    role: 'Ethereum · Lodestar',
    id: '2uwr6wk29lg',
  },
];
---

<Base
  title="Tim Ho — 0xtim.eth"
  description="Distributing crypto education across Chainlink, Fileverse, and Keycard. Writing about privacy, sovereignty, and the people building the stack."
>
  <div class="w-root">
    <!-- Top-right fixed nav -->
    <nav class="topnav" aria-label="Primary">
      <a href="/cv.pdf" class="topnav-link">Resume</a>
      <a href="mailto:tim@tim-hch.com" class="topnav-link">Contact</a>
    </nav>

    <!-- HERO / COVER -->
    <header class="cover">
      <div class="cover-inner">
        <div class="cover-meta">
          <span class="mono">Issue 01 · Independent · 2026</span>
          <span class="mono">youtube.com/@90secondstocrypto</span>
        </div>

        <div class="cover-grid">
          <div class="cover-title">
            <h1>
              Crypto education,
              <span class="ital">distributed</span>
              without the marketing sludge.
            </h1>
          </div>

          <aside class="cover-pull">
            <p>
              I'm an independent creator covering the people building crypto infrastructure — privacy, custody, the sovereignty stack. First at ChainSafe, now full-time on 90 Seconds to Crypto. This site is what I've shipped, written, and the conversations I've been lucky enough to have.
            </p>
            <div class="cover-cta">
              <a href="/cv.pdf" class="cta cta-primary">Read the resume</a>
              <a href="mailto:tim@tim-hch.com" class="cta cta-ghost">Get in touch →</a>
            </div>
          </aside>
        </div>

        <div class="stats">
          <div class="stat">
            <div class="stat-num">3</div>
            <div class="stat-label">Featured distribution partners</div>
          </div>
          <div class="stat">
            <div class="stat-num">220K</div>
            <div class="stat-label">Channel views (YouTube API)</div>
          </div>
          <div class="stat">
            <div class="stat-num">7</div>
            <div class="stat-label">Long-form protocol interviews</div>
          </div>
          <div class="stat">
            <div class="stat-num">2021–25</div>
            <div class="stat-label">DevRel, ChainSafe Systems</div>
          </div>
        </div>
      </div>
      <div class="cover-rule"></div>
    </header>

    <!-- 01 / DISTRIBUTION -->
    <section class="section" id="distribution">
      <div class="section-head">
        <div class="section-head-left">
          <span class="mono accent">01 — Distribution</span>
          <h2>Where the work <span class="ital accent">lands</span>.</h2>
        </div>
        <span class="mono count">{distribution.length.toString().padStart(2, '0')} partners</span>
      </div>

      <div class="dist-grid">
        {distribution.map((d) => (
          <a
            href={d.url}
            class:list={['dist-card', d.accent && 'dist-card-accent']}
            target="_blank"
            rel="noopener"
          >
            {d.accent && (
              <div class="dist-accent-badge">
                <span class="mono">Featured</span>
              </div>
            )}
            <div class="dist-top">
              <span class="mono dist-handle">{d.handle}</span>
              <span class="mono dist-reach">{d.reach}</span>
            </div>
            <div class="dist-name">{d.name}</div>
            <div class="dist-type">{d.type}</div>
            <div class="dist-arrow">
              <span>↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 02 / WRITING -->
    <section class="section" id="writing">
      <div class="section-head">
        <div class="section-head-left">
          <span class="mono accent">02 — Writing</span>
          <h2>The pieces <span class="ital accent">worth your time</span>.</h2>
        </div>
        <span class="mono count">{writing.length.toString().padStart(2, '0')} bylines</span>
      </div>

      <div class="write-grid">
        {writing.map((w) => (
          <a href={w.url ?? '#'} class:list={['write-card', !w.url && 'write-card-soon']} target={w.url ? '_blank' : undefined} rel={w.url ? 'noopener' : undefined}>
            <div class="write-meta">
              <span class="mono">{w.pub}</span>
              <span class="mono">{w.date}</span>
            </div>
            <h3 class="write-title">{w.title}</h3>
            <p class="write-lede">{w.lede}</p>
            <div class="write-arrow">
              <span class="mono">{w.url ? 'Read →' : 'Forthcoming'}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 03 / NETWORK — DARK BAR WITH INTERVIEWS -->
    <section class="section section-dark" id="network">
      <div class="section-head dark-head">
        <div class="section-head-left">
          <span class="mono accent-soft">03 — Conversations</span>
          <h2 class="dark-h2">Long-form interviews with <span class="ital accent-soft">the people doing the work</span>.</h2>
        </div>
        <span class="mono count-dark">{interviews.length.toString().padStart(2, '0')} episodes</span>
      </div>

      <div class="feat-interview">
        <div class="feat-interview-frame">
          <iframe
            src={`https://www.youtube.com/embed/${interviews[0].id}`}
            title={`${interviews[0].name} — ${interviews[0].role}`}
            loading="lazy"
            frameborder="0"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="feat-interview-meta">
          <span class="mono accent-soft">Now playing</span>
          <h3 class="feat-interview-name">{interviews[0].name} <span class="ital">— {interviews[0].role}</span></h3>
          <p>An independent developer I’ve been following since the early contract work. The first conversation I filmed that I still think about weekly.</p>
        </div>
      </div>

      <div class="scroll-rail" aria-label="Other interviews">
        {interviews.slice(1).map((iv) => (
          <a
            href={`https://www.youtube.com/watch?v=${iv.id}`}
            class="thumb-card"
            target="_blank"
            rel="noopener"
          >
            <div class="thumb-frame">
              <img
                src={`https://i.ytimg.com/vi/${iv.id}/hqdefault.jpg`}
                alt={`${iv.name} interview thumbnail`}
                loading="lazy"
              />
              <div class="thumb-play">▶</div>
            </div>
            <div class="thumb-meta">
              <span class="mono">{iv.role}</span>
              <h4>{iv.name}</h4>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="foot">
      <div class="foot-inner">
        <div class="foot-l">
          <span class="mono">© 2026 Tim Ho · 0xtim.eth</span>
        </div>
        <div class="foot-r">
          <a href="mailto:tim@tim-hch.com" class="foot-link">tim@tim-hch.com</a>
          <a href="https://t.me/haochizzle" class="foot-link" target="_blank" rel="noopener">Telegram</a>
          <a href="https://x.com/haochizzle" class="foot-link" target="_blank" rel="noopener">X</a>
          <a href="https://www.youtube.com/@haochizzle" class="foot-link" target="_blank" rel="noopener">YouTube</a>
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* ============================================
     OPTION W — MAGAZINE COVER
     Cream + Fraunces + Inter, dark interview bar
     ============================================ */

  .w-root {
    /* Override Base.astro dark theme just for this page */
    --bg: #f6f3ec;
    --deep: #ede8dc;
    --ink: #1a1814;
    --soft: #4a4640;
    --faint: #8a857c;
    --line: #d8d2c2;
    --accent: #c2410c;
    --accent-soft: #fed7aa;

    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-feature-settings: 'ss01', 'cv11';
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }

  /* Load editorial fonts */
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');

  /* Top-right fixed nav */
  .topnav {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 100;
    display: flex;
    gap: 8px;
    align-items: center;
    background: rgba(246, 243, 236, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px;
  }
  .topnav-link {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    padding: 8px 14px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .topnav-link:hover {
    background: var(--deep);
  }

  .mono {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
  }
  .accent { color: var(--accent); }
  .accent-soft { color: var(--accent-soft); }
  .ital { font-style: italic; font-weight: 500; }

  /* ============================================
     HERO / COVER
     ============================================ */
  .cover {
    padding: 88px 0 0;
  }
  .cover-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .cover-meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  .cover-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 64px;
    padding: 64px 0 80px;
    align-items: end;
  }
  .cover-title h1 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(56px, 8vw, 108px);
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: 0;
  }
  .cover-title h1 .ital {
    color: var(--accent);
  }
  .cover-pull {
    text-align: right;
    padding-bottom: 8px;
  }
  .cover-pull p {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
    font-size: 17px;
    line-height: 1.55;
    color: var(--soft);
    margin-bottom: 28px;
  }
  .cover-cta {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 14px;
    padding: 12px 20px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.18s ease;
    border: 1px solid transparent;
  }
  .cta-primary {
    background: var(--ink);
    color: var(--bg);
  }
  .cta-primary:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .cta-ghost {
    color: var(--ink);
    border-color: var(--line);
    background: transparent;
  }
  .cta-ghost:hover {
    border-color: var(--ink);
  }

  /* Stats row */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--line);
  }
  .stat-num {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .stat-label {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--soft);
    line-height: 1.4;
  }

  .cover-rule {
    height: 8px;
    background: var(--ink);
  }

  /* ============================================
     SECTION SHARED
     ============================================ */
  .section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 96px 32px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 56px;
    gap: 32px;
  }
  .section-head-left {
    flex: 1;
  }
  .section-head h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin-top: 12px;
  }
  .count {
    padding-bottom: 12px;
  }
  .count-dark {
    color: var(--faint);
  }

  /* ============================================
     01 / DISTRIBUTION
     ============================================ */
  .dist-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  .dist-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    color: var(--ink);
    transition: all 0.2s ease;
    overflow: hidden;
    min-height: 280px;
  }
  .dist-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .dist-card-accent {
    grid-row: span 2;
    min-height: 580px;
    background: linear-gradient(160deg, #c2410c 0%, #7c2d12 100%);
    color: var(--bg);
    border-color: transparent;
  }
  .dist-card-accent:hover {
    transform: translateY(-3px);
  }
  .dist-card-accent .dist-handle,
  .dist-card-accent .dist-reach,
  .dist-card-accent .dist-type {
    color: rgba(246, 243, 236, 0.8);
  }
  .dist-card-accent .dist-name {
    color: var(--bg);
    font-size: clamp(40px, 4vw, 64px);
  }
  .dist-card-accent .dist-type {
    color: var(--accent-soft);
  }
  .dist-accent-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(246, 243, 236, 0.15);
    padding: 6px 10px;
    border-radius: 999px;
  }
  .dist-accent-badge .mono {
    color: var(--accent-soft);
    font-size: 10px;
  }
  .dist-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .dist-reach {
    color: var(--accent);
    font-weight: 500;
  }
  .dist-card-accent .dist-reach {
    color: var(--bg);
  }
  .dist-name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    margin-top: auto;
  }
  .dist-type {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.4;
    color: var(--soft);
    margin-bottom: 16px;
  }
  .dist-arrow {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    color: var(--ink);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }
  .dist-card:hover .dist-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .dist-card-accent .dist-arrow {
    color: var(--bg);
    opacity: 1;
    transform: translateX(0);
  }

  /* ============================================
     02 / WRITING
     ============================================ */
  .write-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .write-card {
    background: var(--bg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.18s ease;
    min-height: 340px;
  }
  .write-card:hover {
    background: var(--deep);
  }
  .write-card-soon {
    cursor: default;
    opacity: 0.7;
  }
  .write-card-soon:hover {
    background: var(--bg);
  }
  .write-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 24px;
  }
  .write-title {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .write-lede {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.55;
    color: var(--soft);
    margin-bottom: auto;
  }
  .write-arrow {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .write-arrow .mono {
    color: var(--accent);
    font-weight: 500;
  }
  .write-card-soon .write-arrow .mono {
    color: var(--faint);
  }

  /* ============================================
     03 / NETWORK — DARK BAR
     ============================================ */
  .section-dark {
    background: var(--ink);
    color: var(--bg);
    max-width: none;
    padding: 96px 32px;
    border-radius: 0;
    position: relative;
  }
  .section-dark::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at top right, rgba(194, 65, 12, 0.08), transparent 50%),
      radial-gradient(ellipse at bottom left, rgba(254, 215, 170, 0.04), transparent 50%);
    pointer-events: none;
  }
  .dark-head {
    position: relative;
  }
  .dark-h2 {
    color: var(--bg) !important;
  }
  .dark-h2 .ital {
    color: var(--accent-soft);
  }

  .feat-interview {
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    margin-bottom: 64px;
    align-items: center;
  }
  .feat-interview-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.5);
  }
  .feat-interview-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .feat-interview-meta {
    color: var(--bg);
  }
  .feat-interview-meta .mono {
    color: var(--accent-soft);
    margin-bottom: 16px;
    display: inline-block;
  }
  .feat-interview-name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--bg);
    margin-bottom: 20px;
  }
  .feat-interview-name .ital {
    color: var(--accent-soft);
    font-size: 0.65em;
    font-weight: 400;
  }
  .feat-interview-meta p {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 17px;
    line-height: 1.55;
    color: rgba(246, 243, 236, 0.7);
    font-weight: 400;
  }

  .scroll-rail {
    position: relative;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--faint) transparent;
    padding-bottom: 8px;
    margin: 0 -32px;
    padding-left: 32px;
    padding-right: 32px;
  }
  .scroll-rail::-webkit-scrollbar {
    height: 6px;
  }
  .scroll-rail::-webkit-scrollbar-track {
    background: transparent;
  }

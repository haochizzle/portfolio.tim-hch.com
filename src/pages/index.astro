<script is:inline>
  // Trailer showreel — click poster to play, "Watch another" cycles, rail click jumps
  (function () {
    const posters = document.querySelectorAll('.rail-item');
    const posterWrap = document.getElementById('featuredTrailer');
    const posterImg = document.getElementById('posterImg');
    const posterEl = document.getElementById('trailerPoster');
    const labelEl = document.getElementById('trailerLabel');
    const frameWrap = document.getElementById('trailerFrame');
    const playBtn = document.getElementById('playBtn');
    const nextBtn = document.getElementById('nextTrailer');
    let current = 0;

    const items = Array.from(posters).map((el, i) => ({
      id: el.dataset.id,
      label: el.dataset.label,
      index: i,
      el,
    }));

    function setActive(idx) {
      current = idx;
      const item = items[idx];
      posterImg.src = `https://i.ytimg.com/vi/${item.id}/maxresdefault.jpg`;
      posterImg.alt = item.label;
      labelEl.textContent = item.label;
      frameWrap.hidden = true;
      frameWrap.innerHTML = '';
      posterEl.style.display = '';
      items.forEach(it => it.el.classList.toggle('active', it.index === idx));
    }

    function play() {
      const item = items[current];
      if (!item || item.id.startsWith('TRAILER_')) return; // placeholder
      frameWrap.innerHTML = `<iframe src="https://www.youtube.com/embed/${item.id}?autoplay=1&rel=0" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border-radius:12px;"></iframe>`;
      frameWrap.hidden = false;
      frameWrap.style.cssText = 'position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;';
      posterEl.style.display = 'none';
    }

    function next() {
      const newIdx = (current + 1) % items.length;
      setActive(newIdx);
    }

    items.forEach(item => {
      item.el.addEventListener('click', () => setActive(item.index));
    });
    playBtn?.addEventListener('click', play);
    posterImg?.addEventListener('click', play);
    nextBtn?.addEventListener('click', next);

    // Smooth-scroll active state for nav
    const navLinks = document.querySelectorAll('.nav a');
    const sections = ['top', 'work', 'videos', 'interviews', 'writing', 'social', 'contact'];
    window.addEventListener('scroll', () => {
      let active = sections[0];
      for (const id of sections) {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= 120) active = id;
      }
      navLinks.forEach(a => {
        const href = a.getAttribute('href') || '';
        a.classList.toggle('active', href === `#${active}`);
      });
    }, { passive: true });
  })();
</script>

<style>
  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    font-weight: 700;
    font-size: 1rem;

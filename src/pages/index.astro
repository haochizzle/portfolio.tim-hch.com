</Base>

<script is:inline>
  // Conversation showreel
  (function () {
    const posters = document.querySelectorAll('.rail-item');
    const posterImg = document.getElementById('posterImg');
    const posterEl = document.getElementById('trailerPoster');
    const labelEl = document.getElementById('trailerLabel');
    const frameWrap = document.getElementById('trailerFrame');
    const playBtn = document.getElementById('playBtn');
    const nextBtn = document.getElementById('nextTrailer');
    let current = 0;

    const items = Array.from(posters).map((el, i) => ({
      id: el.dataset.id,
      label: el.dataset.label,
      index: i,
      el,
    }));

    function setActive(idx) {
      current = idx;
      const item = items[idx];
      posterImg.src = `https://i.ytimg.com/vi/${item.id}/maxresdefault.jpg`;
      posterImg.alt = item.label;
      labelEl.textContent = item.label;
      frameWrap.hidden = true;
      frameWrap.innerHTML = '';
      posterEl.style.display = '';
      items.forEach(it => it.el.classList.toggle('active', it.index === idx));
    }

    function play() {
      const item = items[current];
      if (!item) return;
      frameWrap.innerHTML = `<iframe src="https://www.youtube.com/embed/${item.id}?autoplay=1&rel=0" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%;border-radius:12px;"></iframe>`;
      frameWrap.hidden = false;
      frameWrap.style.cssText = 'position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;';
      posterEl.style.display = 'none';
    }

    function next() {
      const newIdx = (current + 1) % items.length;
      setActive(newIdx);
    }

    items.forEach(item => {
      item.el.addEventListener('click', () => setActive(item.index));
    });
    playBtn?.addEventListener('click', play);
    posterImg?.addEventListener('click', play);
    nextBtn?.addEventListener('click', next);

    // Smooth-scroll active state for nav
    const navLinks = document.querySelectorAll('.nav a');
    const sections = ['top', 'work', 'videos', 'conversations', 'writing', 'social', 'contact'];
    window.addEventListener('scroll', () => {
      let active = sections[0];
      for (const id of sections) {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= 120) active = id;
      }
      navLinks.forEach(a => {
        const href = a.getAttribute('href') || '';
        a.classList.toggle('active', href === `#${active}`);
      });
    }, { passive: true });
  })();
</script>

<style>
  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .brand:hover { color: var(--text); }
  .brand-mark { color: var(--accent); }
  .nav { display: flex; gap: 28px; align-items: center; }
  .nav a { color: var(--text-muted); font-size: 0.9rem; font-weight: 500; }
  .nav a:hover, .nav a.active { color: var(--text); }
  .nav-cta {
    background: var(--accent-soft);
    color: var(--accent) !important;
    padding: 8px 14px;
    border-radius: 6px;
  }
  @media (max-width: 720px) {
    .nav { gap: 14px; }
    .nav a:not(.nav-cta) { display: none; }
  }

  /* Hero — ON-DISK ONLINE ONCHAIN */
  .hero { padding: 80px 0 64px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .hero-title {
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 1.0;
    margin-bottom: 24px;
    font-weight: 800;
  }
  .thesis-line {
    display: block;
  }
  .thesis-word {
    display: inline-block;
  }
  .thesis-sep {
    color: var(--accent);
    margin: 0 0.08em;
  }
  .thesis-word.onchain {
    background: linear-gradient(90deg, var(--accent) 0%, #ffffff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 0 16px rgba(250, 204, 21, 0.25));
  }
  .thesis-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 20px;
    font-style: italic;
  }
  .thesis-sub em { font-style: italic; }
  .thesis-body {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 580px;
    margin-bottom: 32px;
  }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-photo {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .photo-frame {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
  }
  .photo-placeholder small { font-size: 0.7rem; opacity: 0.6; }

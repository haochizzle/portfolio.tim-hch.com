        <a href="/cv.pdf" download>CV</a>
        <a href="https://github.com/0xtim" target="_blank" rel="noopener">GitHub</a>
        <a href="https://tim-hch.com" target="_blank" rel="noopener">tim-hch.com</a>
      </div>
    </div>

        <a href="https://x.com/haochizzle" target="_blank" rel="noopener" class="btn btn-ghost">X / Twitter</a>
        <a href="https://youtube.com/@90secondscrypto" target="_blank" rel="noopener" class="btn btn-ghost">YouTube</a>

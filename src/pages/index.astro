---
import Base from "../layouts/Base.astro";
import Chrome from "../components/Chrome.astro";
import Hero from "../components/Hero.astro";
import Syntheses from "../components/Syntheses.astro";
import Conversations from "../components/Conversations.astro";
import Distribution from "../components/Distribution.astro";
import Contact from "../components/Contact.astro";
---

<Base
  title="Tim Ho — 90 Seconds to Crypto"
  description="Writer. Filmmaker. Storyteller. Portfolio of Tim Ho, the creator behind 90 Seconds to Crypto."
>
  <Chrome />
  <main>
    <Hero />
    <Syntheses />
    <Conversations />
    <Distribution />
    <Contact />
  </main>
</Base>

<style is:global>
  main { display: block; }
</style>

    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-left: 2px;
  }
  .metric-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  @media (max-width: 720px) {
    .metrics { grid-template-columns: repeat(2, 1fr); gap: 20px; }

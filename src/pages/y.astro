---
import Base from '../layouts/Base.astro';

// Distribution videos — real IDs from YouTube API (2026-06-26)
const distributionVideos = [
  {
    id: 'dHiHR9jeuF8',
    title: 'Chainlink',
    views: '4.1K',
    desc: 'Meet the slept King of blockchains — long-form deep-dive on the oracle network that quietly holds the on-chain economy together.',
    featured: true,
  },
  {
    id: 'Gu4y0SZNmoU',
    title: 'Fileverse',
    views: '5.4K',
    desc: 'Why Fileverse is the Google Docs killer — self-custody storage that actually performs in production.',
    featured: false,
  },
  {
    id: 'HgXoI4jad-g',
    title: 'Keycard Shell',
    views: '330',
    desc: 'The ugliest crypto wallet — a hardware wallet review for the audience that cares about the engineering.',
    featured: false,
  },
];

const writing = [
  {
    title: 'Introducing the Privacy Engineering Team',
    pub: 'CHAINSAFE SYSTEMS · MEDIUM',
    url: 'https://medium.com/chainsafe-systems/introducing-the-privacy-engineering-team-dcf45511b286',
  },
  {
    title: 'Forget the Money & Hype',
    pub: 'THE CAPITAL · MEDIUM',
    url: 'https://medium.com/thecapital/forget-the-money-and-hype-this-is-the-reason-why-blockchains-will-define-our-future-e9184b375c31',
  },
  {
    title: 'Children of Orchid',
    pub: 'PERSONAL · MEDIUM',
    url: 'https://tim-hch.medium.com/children-of-orchid-2b2f900e6e9b',
  },
];

// Conversations — Jimmy is featured (large iframe), the rest are in a scroll-snap row
const featuredInterview = {
  id: 'OvMEl4L-0bY',
  subject: 'Jimmy',
  context: 'Independent dev',
};

const interviewTrailers = [
  { id: 'SHXgT17J874', subject: 'Timofey', context: 'ChainSafe' },
  { id: '8qhMECRarpE', subject: 'zy0n', context: 'Railgun' },
  { id: 'p-cKWfAj6nI', subject: 'Oskar', context: 'Ethereum Foundation · IPTF' },
  { id: 'N7i1wAnGOpI', subject: 'Alan Scott', context: 'Railgun' },
  { id: '6KaxUw5YZe0', subject: 'Chris Blake', context: 'Independent researcher' },
  { id: '2uwr6wk29lg', subject: 'Phil Ngo', context: 'Ethereum · Lodestar' },
];

const sections = [
  { id: 'intro', num: '00', label: 'Intro' },
  { id: 'distribution', num: '01', label: 'Distribution' },
  { id: 'writing', num: '02', label: 'Writing' },
  { id: 'network', num: '03', label: 'Network' },

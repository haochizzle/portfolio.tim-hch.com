---
// Footer / Contact section
---

<section class="contact" id="contact">
  <div class="stage">
    <div class="actions">
      <a class="action" href="/cv.pdf" download>
        <span class="action-eyebrow mono">For recruiters</span>
        <span class="action-label serif">Download CV</span>
        <span class="action-arrow" aria-hidden="true">→</span>
      </a>
      <a class="action" href="mailto:contact@tim-hch.com">
        <span class="action-eyebrow mono">Direct line</span>
        <span class="action-label serif">contact@tim-hch.com</span>
        <span class="action-arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <p class="colophon mono">
      © 2026 Tim Ho · <a href="https://x.com/haochizzle" target="_blank" rel="noopener">@haochizzle</a> · <a href="https://90secondstocryp.to" target="_blank" rel="noopener">90secondstocryp.to</a>
    </p>
  </div>
</section>

<style>
  .contact {
    min-height: 70vh;
    min-height: 70svh;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 24px 64px;
    border-top: 1px solid var(--rule);
  }

  .stage {
    max-width: 720px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: 100%;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .action {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 48px 32px;
    color: var(--ink);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 900ms var(--ease), transform 900ms var(--ease), background 350ms var(--ease);
  }
  .contact.in .action {
    opacity: 1;
    transform: translateY(0);
  }
  .contact.in .action:first-child {
    transition-delay: 100ms;
  }
  .contact.in .action:last-child {
    transition-delay: 280ms;
  }

  .action:first-child { border-right: 1px solid var(--rule); }
  .action:hover { background: var(--cream-deep); }

  .action-eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .action-label {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .action-arrow {
    font-size: 1.4rem;
    margin-top: 16px;
    transition: transform 350ms var(--ease);
  }
  .action:hover .action-arrow { transform: translateX(8px); }

  .colophon {
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .colophon a {
    color: var(--ink-mute);
    transition: color 200ms var(--ease);
  }
  .colophon a:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .actions { grid-template-columns: 1fr; }
    .action:first-child { border-right: 0; border-bottom: 1px solid var(--rule); }
  }
</style>

<script>
  const section = document.getElementById("contact");
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          section?.classList.add("in");
          io.disconnect();
        }
      });
    },
    { threshold: 0.3 }
  );
  if (section) io.observe(section);
</script>

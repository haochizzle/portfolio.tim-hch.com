---
import { syntheses } from "../data/content.ts";
import ScrollCue from "./ScrollCue.astro";

const logos: Record<string, string> = {
  "chainlink-quadrillions": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L4 7v10l8 5 8-5V7l-8-5z"/><path d="M12 2v20M4 7l16 10M20 7L4 17"/></svg>`,
  "fileverse-anti-docs": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>`,
  "keycard-shell-gameboy": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="1.5"/><circle cx="8" cy="12" r="1.5" fill="currentColor"/><circle cx="16" cy="12" r="1.5" fill="currentColor"/></svg>`,
  "zora-paid-me": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/></svg>`,
};
---

<section class="syntheses" id="syntheses">
  <div class="strike-line" aria-hidden="true"></div>

  <div class="stage">
    <h2 class="arc-title" aria-label="Syntheses">
      <span class="title-text cursive">Syntheses</span>
    </h2>

    <div class="carousel" data-carousel>
      <button class="nav prev" aria-label="Previous">←</button>
      <div class="track" data-track>
        {syntheses.map((v, i) => (
          <article class="card video-card" style={`--i:${i}`}>
            <div class="embed">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`}
                title={v.title}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                data-embed-iframe
              ></iframe>
            </div>
            <div class="meta">
              <div class="logo" aria-hidden="true" set:html={logos[v.id] ?? ""}></div>
              <h3 class="serif">{v.title}</h3>
            </div>
          </article>
        ))}
      </div>
      <button class="nav next" aria-label="Next">→</button>
    </div>
  </div>
  <ScrollCue label="Continue" />
</section>

<style>
  /* === STRUCTURE MIRRORS Conversations EXACTLY === */
  .syntheses {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--cream);
    overflow: hidden;
  }

  /* Strike line — IDENTICAL to Conversations, but fades out after sweep */
  .strike-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent-glow), 0 0 32px var(--accent-glow);
    transform: translateY(-50%) scaleX(0);
    transform-origin: left center;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
  }
  .syntheses.strike .strike-line {
    animation:
      strike-sweep 700ms var(--ease) forwards,
      strike-fade 500ms ease 700ms forwards;
  }
  @keyframes strike-sweep {
    0%   { transform: translateY(-50%) scaleX(0); opacity: 1; }
    100% { transform: translateY(-50%) scaleX(1); opacity: 1; }
  }
  @keyframes strike-fade {
    to { opacity: 0; }
  }

  /* Stage — IDENTICAL to Conversations */
  .stage {
    position: relative;
    z-index: 3;
    max-width: 900px;
    margin: 0 auto;
    padding: 100px 24px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    height: 100%;
    justify-content: center;
  }

  /* === CURSIVE TITLE — fades up, same fade-in timing as Conversations === */
  .arc-title {
    margin: 0;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 800ms var(--ease) 700ms, transform 800ms var(--ease) 700ms;
  }
  .syntheses.reveal .arc-title {
    opacity: 1;
    transform: translateY(0);
  }
  .title-text {
    font-family: var(--cursive);
    font-size: 7rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
  }

  /* === CAROUSEL — IDENTICAL to Conversations === */
  .carousel {
    flex: 1;
    position: relative;
    min-height: 0;
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 32px;
    padding: 8px 4px 24px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }

  /* Card — IDENTICAL to Conversations (no flex, no min-height) */
  .video-card {
    flex: 0 0 100%;
    scroll-snap-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 700ms var(--ease), transform 700ms var(--ease);
  }
  .syntheses.reveal .video-card {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(900ms + var(--i) * 100ms);
  }

  /* Embed — IDENTICAL to Conversations */
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--cream-deep);
    overflow: hidden;
    border: 1px solid var(--rule);
  }
  .embed iframe {
    width: 100%; height: 100%; border: 0; display: block;
    pointer-events: none;
  }
  .video-card:hover .embed iframe,
  .video-card:focus-within .embed iframe {
    pointer-events: auto;
  }

  /* Meta — IDENTICAL pattern to Conversations meta (logo + title) */
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding: 0 4px;
  }
  .logo {
    width: 24px;
    height: 24px;
    color: var(--ink);
    flex-shrink: 0;
  }
  .logo :global(svg) { width: 100%; height: 100%; }
  .meta h3 {
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0;
  }

  /* Nav — IDENTICAL to Conversations */
  .nav {
    position: absolute;
    top: calc(50% - 40px);
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    background: var(--cream);
    color: var(--ink);
    font-size: 1.1rem;
    z-index: 3;
    transition: border-color 250ms var(--ease), background 250ms var(--ease);
  }
  .nav:hover { border-color: var(--accent); background: var(--accent); color: var(--cream); }
  .nav.prev { left: -56px; }
  .nav.next { right: -56px; }
  @media (max-width: 980px) {
    .nav.prev { left: 4px; }
    .nav.next { right: 4px; }
  }

  /* Title responsive — keep it big */
  @media (max-width: 720px) {
    .title-text { font-size: 4.5rem; }
  }
</style>

<script>
  const syntheses = document.getElementById("syntheses");
  if (syntheses) {
    let triggered = false;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !triggered) {
            triggered = true;
            // Phase 1: strike line sweeps + title starts fading
            syntheses.classList.add("strike");
            // Phase 2: after strike completes, fade in cards
            setTimeout(() => {
              syntheses.classList.add("reveal");
            }, 700);
            io.disconnect();
          }
        });
      },
      { threshold: 0.4 }
    );
    io.observe(syntheses);
  }
</script>
</content>
</invoke>
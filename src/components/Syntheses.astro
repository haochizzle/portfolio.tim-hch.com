---
import { syntheses } from "../data/content.ts";
import ScrollCue from "./ScrollCue.astro";

const logos: Record<string, string> = {
  "chainlink-quadrillions": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L4 7v10l8 5 8-5V7l-8-5z"/><path d="M12 2v20M4 7l16 10M20 7L4 17"/></svg>`,
  "fileverse-anti-docs": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>`,
  "keycard-shell-gameboy": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="1.5"/><circle cx="8" cy="12" r="1.5" fill="currentColor"/><circle cx="16" cy="12" r="1.5" fill="currentColor"/></svg>`,
  "zora-paid-me": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/></svg>`,
};
---

<section class="syntheses" id="syntheses">
  <div class="strike-line" aria-hidden="true"></div>

  <div class="stage">
    <h2 class="arc-title cursive" aria-label="Syntheses">
      <span class="title-text">Syntheses</span>
    </h2>

    <div class="carousel" data-carousel>
      <button class="nav prev" aria-label="Previous">←</button>
      <div class="track" data-track>
        {syntheses.map((v, i) => (
          <article class="card video-card" style={`--i:${i}`}>
            <div class="embed">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`}
                title={v.title}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                data-embed-iframe
              ></iframe>
            </div>
            <div class="meta">
              <div class="logo" aria-hidden="true" set:html={logos[v.id] ?? ""}></div>
              <div class="meta-text">
                <h3 class="serif">{v.title}</h3>
              </div>
            </div>
          </article>
        ))}
      </div>
      <button class="nav next" aria-label="Next">→</button>
    </div>
  </div>
  <ScrollCue label="Continue" />
</section>

<style>
  /* === STRUCTURE MIRRORS Conversations EXACTLY === */
  .syntheses {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Strike line — IDENTICAL to Conversations */
  .strike-line {
    position: absolute;
    left: 0; right: 0;
    top: 50%;
    height: 1px;
    background: #1f4ed8;
    transform: scaleX(0);
    transform-origin: left center;
    z-index: 2;
  }
  .syntheses.strike .strike-line {
    animation: strike 700ms var(--ease) forwards;
  }
  @keyframes strike {
    to { transform: scaleX(1); }
  }

  .stage {
    width: 100%;
    max-width: 1400px;
    padding: 0 64px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    height: 100%;
    align-items: stretch;
    justify-content: center;
  }

  /* === CURSIVE TITLE — big, fade-up, identical timing pattern to Conversations === */
  .arc-title {
    width: 100%;
    text-align: center;
    margin: 0;
    flex-shrink: 0;
    position: relative;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .arc-title .title-text {
    font-family: var(--cursive);
    font-size: 110px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
    opacity: 0;
    transform: translateY(30px);
  }
  /* Phase 1 (strike): title fades in */
  .syntheses.strike .title-text {
    animation: title-in 1200ms var(--ease) forwards;
  }
  @keyframes title-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* === THEATRE CAROUSEL — IDENTICAL TO CONVERSATIONS === */
  .carousel {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 0;
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 32px;
    padding: 8px 4px 24px;
    -ms-overflow-style: none;
    scrollbar-width: none;
    height: 100%;
  }
  .track::-webkit-scrollbar { display: none; }

  .video-card {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 0;
    opacity: 0;
    transform: translateY(30px);
  }
  .syntheses.reveal .video-card {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 800ms var(--ease), transform 800ms var(--ease);
    transition-delay: calc(1400ms + var(--i) * 80ms);
  }

  .embed {
    position: relative;
    flex: 1;
    min-height: 0;
    aspect-ratio: 16 / 9;
    background: var(--cream-deep);
    overflow: hidden;
    border: 1px solid var(--rule);
    max-height: 75vh;
    align-self: center;
    width: 100%;
  }
  .embed iframe {
    width: 100%; height: 100%; border: 0; display: block;
    pointer-events: none;
  }
  .video-card:hover .embed iframe,
  .video-card:focus-within .embed iframe {
    pointer-events: auto;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    padding: 0 8px;
  }
  .logo {
    width: 28px;
    height: 28px;
    color: var(--ink);
    flex-shrink: 0;
  }
  .logo :global(svg) { width: 100%; height: 100%; }
  .meta h3 {
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    background: var(--cream);
    color: var(--ink);
    font-size: 1.1rem;
    z-index: 3;
    transition: border-color 250ms var(--ease), background 250ms var(--ease);
  }
  .nav:hover { border-color: var(--accent); background: var(--accent); color: var(--cream); }
  .nav.prev { left: -56px; }
  .nav.next { right: -56px; }
  @media (max-width: 1100px) {
    .stage { padding: 0 32px; }
    .nav.prev { left: 4px; }
    .nav.next { right: 4px; }
  }
</style>

<script>
  const syntheses = document.getElementById("syntheses");
  if (syntheses) {
    let triggered = false;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !triggered) {
            triggered = true;
            // Phase 1: title starts drawing immediately
            syntheses.classList.add("strike");
            // Phase 2: After strike completes, fade in title + drop cards
            setTimeout(() => {
              syntheses.classList.add("reveal");
            }, 700);
            io.disconnect();
          }
        });
      },
      { threshold: 0.4 }
    );
    io.observe(syntheses);
  }
</script>

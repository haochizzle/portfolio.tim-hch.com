---
import { syntheses } from "../data/content.ts";
import ScrollCue from "./ScrollCue.astro";

// Inline SVG partner logos — clean monochrome, no external deps.
// Replace these with real ones when partner assets are provided.
const logos: Record<string, string> = {
  "chainlink-quadrillions": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L4 7v10l8 5 8-5V7l-8-5z"/><path d="M12 2v20M4 7l16 10M20 7L4 17"/></svg>`,
  "fileverse-anti-docs": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>`,
  "keycard-shell-gameboy": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="1.5"/><circle cx="8" cy="12" r="1.5" fill="currentColor"/><circle cx="16" cy="12" r="1.5" fill="currentColor"/></svg>`,
  "zora-paid-me": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/></svg>`,
};
---

<section class="syntheses" id="syntheses">
  <div class="stage">
    <h2 class="arc-title cursive" aria-label="Syntheses" data-title>
      <span class="fallback cursive">Syntheses</span>
      <svg class="cursive-svg" viewBox="0 0 600 140" aria-hidden="true">
        <defs>
          <path id="synth-path" d="M 20 100 Q 50 30, 90 80 Q 130 130, 180 70 Q 230 20, 290 80 Q 350 130, 400 70 Q 450 30, 510 80 Q 560 110, 580 80" fill="none" />
        </defs>
        <text class="cursive-stroke">
          <textPath href="#synth-path" startOffset="0">Syntheses</textPath>
        </text>
      </svg>
    </h2>

    <div class="row" data-row>
      {syntheses.map((v, i) => (
        <article class="card video-card" style={`--i:${i}`}>
          <div class="logo" aria-hidden="true" set:html={logos[v.id] ?? ""}></div>
          <h3 class="serif">{v.title}</h3>
          <div class="embed">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`}
              title={v.title}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              data-embed-iframe
            ></iframe>
          </div>
        </article>
      ))}
    </div>
  </div>
  <ScrollCue label="Continue" />
</section>

<style>
  .syntheses {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--cream);
    padding: 80px 48px 80px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage {
    width: 100%;
    max-width: 1400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  /* Cursive title — draw-on via stroke-dashoffset, triggered when in view */
  .arc-title {
    width: 100%;
    max-width: 600px;
    text-align: center;
    position: relative;
    margin: 0;
    height: 120px;
    flex-shrink: 0;
  }
  .arc-title .fallback { display: none; }
  .arc-title .cursive-svg { width: 100%; height: 100%; overflow: visible; display: block; }

  .cursive-stroke text {
    font-family: var(--cursive);
    font-size: 130px;
    font-weight: 700;
    fill: transparent;
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
  }
  /* When section enters view, run the draw */
  .syntheses.in .cursive-stroke text {
    animation:
      draw 1800ms var(--ease) forwards,
      fill-in 700ms var(--ease) 1700ms forwards;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes fill-in {
    to { fill: var(--ink); stroke-width: 0.3; }
  }

  /* Single row of 4 — no >1 row, no >1 column */
  .row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
    flex: 1;
    min-height: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transform: translateY(40px);
    min-height: 0;
  }
  .syntheses.in .card {
    animation: card-in 700ms var(--ease) forwards;
    animation-delay: calc(2400ms + var(--i) * 110ms);
  }
  @keyframes card-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .logo {
    width: 32px;
    height: 32px;
    color: var(--ink);
    flex-shrink: 0;
  }
  .logo :global(svg) { width: 100%; height: 100%; }

  .card h3 {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--cream-deep);
    overflow: hidden;
    border: 1px solid var(--rule);
    flex: 1;
    min-height: 0;
  }
  .embed iframe {
    width: 100%; height: 100%; border: 0;
    /* Default: pass wheel/scroll events through to page so snap works */
    pointer-events: none;
  }
  /* When user hovers the card, allow iframe interaction */
  .video-card:hover .embed iframe,
  .video-card:focus-within .embed iframe {
    pointer-events: auto;
  }

  /* Horizontal scroll on narrow screens — still 1 row, but scrollable */
  @media (max-width: 1100px) {
    .row {
      grid-template-columns: repeat(4, 280px);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 8px;
    }
    .card { scroll-snap-align: start; }
  }
  @media (max-width: 720px) {
    .syntheses { padding: 80px 16px 60px; }
    .row { grid-template-columns: repeat(4, 240px); gap: 12px; }
  }
</style>

<script>
  // Trigger cursive draw + card drop when section enters viewport
  const syntheses = document.getElementById("syntheses");
  if (syntheses) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            syntheses.classList.add("in");
            io.disconnect();
          }
        });
      },
      { threshold: 0.4 }
    );
    io.observe(syntheses);
  }
</script>

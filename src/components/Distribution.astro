---
import { distribution } from "../data/content.ts";
import ScrollCue from "./ScrollCue.astro";

const fmt = (n: number) => n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n);
const fmtDate = (iso: string) => {
  // X-style: "Jan 12, 2026" (X uses "·" + date with no year if same year; we use month day, year)
  const d = new Date(iso);
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
};
const truncate = (s: string, n: number) => s.length > n ? s.slice(0, n).trim() + "…" : s;

const WORD = "Distribution";
// Pre-compute letter spawn positions so they look like parts flying in
const spawnPositions = [
  { tx: "-260%", ty: "-180%", rz: "-90deg",  delay: 0 },
  { tx: "280%",  ty: "-140%", rz: "120deg",  delay: 60 },
  { tx: "-200%", ty: "200%",  rz: "-60deg",  delay: 120 },
  { tx: "260%",  ty: "180%",  rz: "150deg",  delay: 180 },
  { tx: "-300%", ty: "60%",   rz: "200deg",  delay: 240 },
  { tx: "240%",  ty: "-220%", rz: "-150deg", delay: 300 },
  { tx: "-280%", ty: "-80%",  rz: "90deg",   delay: 360 },
  { tx: "300%",  ty: "100%",  rz: "-200deg", delay: 420 },
  { tx: "-180%", ty: "260%",  rz: "60deg",   delay: 480 },
  { tx: "200%",  ty: "-260%", rz: "180deg",  delay: 540 },
  { tx: "-240%", ty: "-200%", rz: "-30deg",  delay: 600 },
  { tx: "260%",  ty: "220%",  rz: "-120deg", delay: 660 },
];
---

<section class="distribution" id="distribution">
  <div class="stage">
    <h2 class="arc-title serif" data-text={WORD} aria-label={WORD}>
      {Array.from(WORD).map((c, i) => (
        <span
          class="glyph"
          style={`--i:${i}; --tx:${spawnPositions[i].tx}; --ty:${spawnPositions[i].ty}; --rz:${spawnPositions[i].rz}; --d:${spawnPositions[i].delay}ms;`}
        >{c}</span>
      ))}
    </h2>

    <div class="carousel" data-carousel>
      <button class="nav prev" aria-label="Previous">←</button>
      <div class="track" data-track>
        {distribution.map((item, i) => {
          if (item.kind === "tweet") {
            return (
              <article class="card tweet" style={`--i:${i}`}>
                <header class="card-head">
                  <div class="avatar">TH</div>
                  <div class="who">
                    <div class="name-row">
                      <span class="display-name">Tim Ho</span>
                      <svg class="verified" viewBox="0 0 22 22" aria-label="Verified"><path fill="#1d9bf0" d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.256.14-1.884-.132-.628-.437-1.205-.88-1.675-.444-.47-.99-.79-1.604-.923-.614-.132-1.247-.083-1.83.143-.296-.587-.766-1.07-1.357-1.39-.59-.32-1.265-.45-1.93-.39-.665.062-1.295.27-1.823.61-.528.34-.953.806-1.226 1.348-.596-.238-1.246-.305-1.872-.193-.626.113-1.21.376-1.692.766-.482.39-.853.9-1.077 1.485-.224.584-.29 1.222-.198 1.85-.616.27-1.13.7-1.49 1.245-.36.545-.555 1.18-.564 1.83-.01.65.164 1.292.493 1.847.328.555.815 1.012 1.4 1.318-.156.62-.156 1.27 0 1.89.155.62.45 1.19.852 1.65.402.46.9.81 1.45 1.03.55.21 1.14.29 1.73.22.27.6.7 1.13 1.26 1.5.55.38 1.2.59 1.86.6.66.01 1.31-.18 1.86-.55.55-.36 1-.88 1.27-1.49.59.07 1.18.01 1.74-.21.55-.21 1.05-.55 1.45-1 .4-.45.7-.99.86-1.58.16-.59.18-1.21.05-1.81.61-.27 1.13-.7 1.49-1.24.36-.55.55-1.18.56-1.83zm-9.42 7.04l-4.85-4.85 1.41-1.41 3.44 3.44 6.7-6.7 1.41 1.41-8.11 8.11z"/></svg>
                      <span class="handle">@haochizzle</span>
                    </div>
                    <div class="sub">{fmtDate(item.postedAt)}</div>
                  </div>
                  <div class="x-mark">𝕏</div>
                </header>
                <p class="body">{truncate(item.text, 280)}</p>
                <div class="actions">
                  <span class="action"><span class="icon" aria-hidden="true">💬</span> {fmt(item.replies)}</span>
                  <span class="action"><span class="icon" aria-hidden="true">↻</span> {fmt(item.retweets)}</span>
                  <span class="action"><span class="icon" aria-hidden="true">♡</span> {fmt(item.likes)}</span>
                  <span class="action share"><span class="icon" aria-hidden="true">↗</span></span>
                </div>
                <a class="card-link" href={item.url} target="_blank" rel="noopener" aria-label="View on X"></a>
              </article>
            );
          }
          return (
            <article class="card reddit" style={`--i:${i}`}>
              <header class="card-head reddit-head">
                <div class="avatar reddit-avatar">r/</div>
                <div class="who">
                  <div class="name-row">
                    <span class="display-name">{item.subreddit}</span>
                    <span class="handle">· u/haochizzle</span>
                  </div>
                  <div class="sub">{fmtDate(item.postedAt)}</div>
                </div>
              </header>
              <h3 class="title">{item.title}</h3>
              <p class="body">{truncate(item.body, 280)}</p>
              <div class="actions reddit-actions">
                <span class="action"><span class="icon" aria-hidden="true">▲</span> {fmt(item.upvotes)}</span>
                <span class="action"><span class="icon" aria-hidden="true">💬</span> {fmt(item.comments)}</span>
                <span class="action"><span class="icon" aria-hidden="true">↗</span> Share</span>
                <span class="action"><span class="icon" aria-hidden="true">★</span> Save</span>
              </div>
              <a class="card-link" href={item.url} target="_blank" rel="noopener" aria-label="View on Reddit"></a>
            </article>
          );
        })}
      </div>
      <button class="nav next" aria-label="Next">→</button>
    </div>
  </div>
  <ScrollCue label="Continue" />
</section>

<style>
  .distribution {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--cream);
    padding: 100px 32px 80px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage {
    width: 100%;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  /* Transformer assembly — letters fly in from random positions with rotation, then lock in */
  .arc-title {
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    display: flex;
    perspective: 800px;
    margin: 0;
  }
  .glyph {
    display: inline-block;
    opacity: 0;
    transform:
      translate(var(--tx), var(--ty))
      rotate(var(--rz))
      scale(1.8);
    transform-origin: 50% 50%;
    transition: transform 900ms var(--ease-out), opacity 400ms var(--ease);
    will-change: transform, opacity;
  }
  .distribution.in .glyph {
    opacity: 1;
    transform: translate(0, 0) rotate(0deg) scale(1);
    transition-delay: var(--d);
    transition-duration: 900ms;
  }
  /* Mechanical lock-in: tiny scale punch after landing */
  .distribution.in .glyph::after {
    content: "";
  }

  /* CARDS — single tweet or reddit, like the actual X / Reddit embeds */
  .carousel { position: relative; width: 100%; }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 28px;
    padding: 8px 4px 24px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }

  .card {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    background: transparent;
    border: 0;
    padding: 20px 0 0;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 700ms var(--ease), transform 700ms var(--ease);
  }
  .distribution.reveal .card {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(1100ms + var(--i) * 80ms);
  }

  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* X-card head — exact structure of x.com embed */
  .card-head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
    position: relative;
    z-index: 2;
  }
  .avatar {
    width: 40px;
    height: 40px;
    background: var(--ink);
    color: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .reddit-avatar {
    background: #ff4500;
    color: var(--cream);
  }
  .who { flex: 1; min-width: 0; padding-top: 2px; }
  .name-row {
    display: flex;
    align-items: center;
    gap: 4px;
    line-height: 1.1;
  }
  .display-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .verified {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .handle {
    color: var(--ink-dim);
    font-size: 0.9rem;
    font-weight: 400;
  }
  .sub {
    color: var(--ink-dim);
    font-size: 0.85rem;
    margin-top: 2px;
  }
  .x-mark {
    color: var(--ink);
    font-size: 1.1rem;
    line-height: 1;
    padding-top: 4px;
  }

  /* Tweet body — X card style: regular weight, slightly larger */
  .body {
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0 0 14px 52px;
    white-space: pre-wrap;
    position: relative;
    z-index: 2;
  }
  .tweet .body, .reddit .body {
    margin-left: 52px;
  }

  /* Reddit title — same indent as body */
  .title {
    font-family: var(--sans);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 8px 52px;
    color: var(--ink);
    position: relative;
    z-index: 2;
  }

  /* Action bar — same indent as body */
  .actions {
    display: flex;
    gap: 28px;
    color: var(--ink-dim);
    font-size: 0.82rem;
    padding: 8px 0 8px 52px;
    position: relative;
    z-index: 2;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 200ms var(--ease);
  }
  .action .icon {
    font-size: 0.95rem;
    line-height: 1;
  }
  .action:hover { color: var(--accent); }
  .action.share { margin-left: auto; }

  /* Reddit specific */
  .reddit-head { margin-bottom: 8px; }
  .reddit-actions { padding-top: 12px; }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    background: var(--cream);
    color: var(--ink);
    font-size: 1.1rem;
    z-index: 3;
    transition: border-color 250ms var(--ease), background 250ms var(--ease);
  }
  .nav:hover { border-color: var(--accent); background: var(--accent); color: var(--cream); }
  .nav.prev { left: -56px; }
  .nav.next { right: -56px; }
  @media (max-width: 980px) {
    .nav.prev { left: 4px; }
    .nav.next { right: 4px; }
  }
</style>

<script>
  const section = document.getElementById("distribution");
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          // Phase 1: title assembly
          section?.classList.add("in");
          // Phase 2: cards reveal after assembly completes (~1100ms)
          setTimeout(() => {
            section?.classList.add("reveal");
          }, 1200);
          io.disconnect();
        }
      });
    },
    { threshold: 0.4 }
  );
  if (section) io.observe(section);

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((c) => {
    const track = c.querySelector<HTMLElement>("[data-track]");
    if (!track) return;
    c.querySelector(".prev")?.addEventListener("click", () =>
      track.scrollBy({ left: -track.clientWidth, behavior: "smooth" })
    );
    c.querySelector(".next")?.addEventListener("click", () =>
      track.scrollBy({ left: track.clientWidth, behavior: "smooth" })
    );
  });
</script>

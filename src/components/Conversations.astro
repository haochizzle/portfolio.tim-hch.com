---
import { conversations } from "../data/content.ts";
import ScrollCue from "./ScrollCue.astro";
---

<section class="conversations" id="conversations">
  <canvas class="babble-canvas" id="babble-canvas" aria-hidden="true"></canvas>
  <div class="strike-line" id="strike-line" aria-hidden="true"></div>

  <div class="stage">
    <h2 class="arc-title serif" aria-label="Conversations">Conversations</h2>

    <div class="carousel" data-carousel>
      <button class="nav prev" aria-label="Previous">←</button>
      <div class="track" data-track>
        {conversations.map((c, i) => (
          <article class="card conv-card" style={`--i:${i}`}>
            <div class="embed">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${c.youtubeId}`}
                title={`${c.guest} — ${c.title}`}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <div class="meta">
              <span class="guest mono">{c.guest}</span>
              <h3 class="serif">{c.title}</h3>
              <p>{c.context}</p>
            </div>
          </article>
        ))}
      </div>
      <button class="nav next" aria-label="Next">→</button>
    </div>
  </div>
  <ScrollCue label="Continue" />
</section>

<style>
  .conversations {
    position: relative;
    height: 100vh;
    height: 100svh;
    background: var(--cream);
    overflow: hidden;
  }

  .babble-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transition: opacity 900ms var(--ease);
  }

  /* The line — sits centered vertically, starts off-screen left,
     sweeps right, scythes through the speech bubbles. */
  .strike-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent-glow), 0 0 32px var(--accent-glow);
    transform: translateY(-50%) scaleX(0);
    transform-origin: left center;
    z-index: 2;
    pointer-events: none;
  }
  .conversations.strike .strike-line {
    animation: strike-sweep 700ms var(--ease) forwards;
  }
  @keyframes strike-sweep {
    0%   { transform: translateY(-50%) scaleX(0); }
    100% { transform: translateY(-50%) scaleX(1); }
  }

  .stage {
    position: relative;
    z-index: 3;
    max-width: 900px;
    margin: 0 auto;
    padding: 100px 24px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    height: 100%;
    justify-content: center;
  }

  /* Title — opacity 0 until the strike clears the babble */
  .arc-title {
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 600ms var(--ease) 700ms, transform 600ms var(--ease) 700ms;
  }
  .conversations.reveal .arc-title {
    opacity: 1;
    transform: translateY(0);
  }

  .carousel {
    position: relative;
    width: 100%;
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 32px;
    padding: 8px 4px 24px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }

  .conv-card {
    flex: 0 0 100%;
    scroll-snap-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 700ms var(--ease), transform 700ms var(--ease);
  }
  .conversations.reveal .conv-card {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(900ms + var(--i) * 100ms);
  }

  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--cream-deep);
    overflow: hidden;
    border: 1px solid var(--rule);
  }
  .embed iframe { width: 100%; height: 100%; border: 0; }

  .meta { margin-top: 20px; text-align: center; }
  .guest {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .meta h3 { font-size: 1.6rem; font-weight: 500; margin-bottom: 6px; }
  .meta p { color: var(--ink-mute); font-size: 0.95rem; max-width: 560px; margin: 0 auto; }

  .nav {
    position: absolute;
    top: 38%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    background: var(--cream);
    color: var(--ink);
    font-size: 1.1rem;
    z-index: 3;
    transition: border-color 250ms var(--ease), background 250ms var(--ease);
  }
  .nav:hover { border-color: var(--accent); background: var(--accent); color: var(--cream); }
  .nav.prev { left: -56px; }
  .nav.next { right: -56px; }
  @media (max-width: 980px) {
    .nav.prev { left: 4px; }
    .nav.next { right: 4px; }
  }
</style>

<script>
  const section = document.getElementById("conversations");
  const canvas = document.getElementById("babble-canvas") as HTMLCanvasElement | null;
  const line = document.getElementById("strike-line");
  let triggered = false;
  let cleanup: (() => void) | undefined;

  // Speech-bubble babble — denser, more overlapping than before.
  function setupBabble(c: HTMLCanvasElement) {
    const ctx = c.getContext("2d");
    if (!ctx) return;
    const dpr = window.devicePixelRatio || 1;
    const resize = () => {
      c.width = c.clientWidth * dpr;
      c.height = c.clientHeight * dpr;
    };
    resize();
    window.addEventListener("resize", resize);

    type Bubble = { x: number; y: number; vx: number; vy: number; text: string; alpha: number; size: number; };
    const bubbles: Bubble[] = [];
    const phrases = [
      "yeah so basically", "the thing is", "no but listen", "right right right",
      "I mean technically", "from what I've seen", "this is the part", "they don't tell you",
      "but actually", "ok so here's the deal", "wait wait wait", "the real insight is",
      "for sure", "totally", "exactly", "you know what I mean", "and then",
      "so wait", "I think", "look", "honestly",
    ];
    const fill = () => {
      const w = c.clientWidth;
      const h = c.clientHeight;
      const target = 24;
      while (bubbles.length < target) {
        bubbles.push({
          x: Math.random() * w,
          y: h * 0.15 + Math.random() * h * 0.7,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.3,
          text: phrases[Math.floor(Math.random() * phrases.length)],
          alpha: 0.5 + Math.random() * 0.4,
          size: 11 + Math.random() * 4,
        });
      }
    };

    let running = true;
    const draw = () => {
      if (!running) return;
      ctx.clearRect(0, 0, c.width, c.height);
      ctx.save();
      ctx.scale(dpr, dpr);
      for (const b of bubbles) {
        b.x += b.vx;
        b.y += b.vy;
        if (b.x < 20) b.vx = Math.abs(b.vx);
        if (b.x > c.clientWidth - 20) b.vx = -Math.abs(b.vx);
        if (b.y < 20) b.vy = Math.abs(b.vy);
        if (b.y > c.clientHeight - 20) b.vy = -Math.abs(b.vy);

        ctx.globalAlpha = b.alpha;
        ctx.font = `${b.size}px "Inter", sans-serif`;
        const w = ctx.measureText(b.text).width + 20;
        const h = b.size + 12;
        ctx.fillStyle = "#1f4ed8";
        roundedRect(ctx, b.x - w / 2, b.y - h / 2, w, h, 12);
        ctx.fill();
        ctx.fillStyle = "#f3efe5";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(b.text, b.x, b.y);
      }
      ctx.restore();
      requestAnimationFrame(draw);
    };
    fill();
    draw();

    return () => { running = false; };
  }

  function roundedRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // Sequence when section enters viewport:
  // 1. Babble fills screen
  // 2. Blue line sweeps left-to-right through babble (clears it visually)
  // 3. Title "Conversations" fades in
  // 4. Cards drop in
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting && !triggered) {
          triggered = true;
          if (canvas && !cleanup) cleanup = setupBabble(canvas);
          // Babble renders for ~1.6s before strike
          setTimeout(() => {
            section?.classList.add("strike");
            // Hide babble at end of strike (the line "cleared" it)
            setTimeout(() => {
              if (canvas) canvas.style.opacity = "0";
              section?.classList.add("reveal");
            }, 700);
          }, 1600);
          io.disconnect();
        }
      });
    },
    { threshold: 0.4 }
  );
  if (section) io.observe(section);

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((c) => {
    const track = c.querySelector<HTMLElement>("[data-track]");
    if (!track) return;
    c.querySelector(".prev")?.addEventListener("click", () =>
      track.scrollBy({ left: -track.clientWidth, behavior: "smooth" })
    );
    c.querySelector(".next")?.addEventListener("click", () =>
      track.scrollBy({ left: track.clientWidth, behavior: "smooth" })
    );
  });
</script>

---
// Smooth IntersectionObserver-driven snap.
// When a section's center crosses 50% of viewport, snap to it.
// No wheel handler — uses real scroll, just snaps when you cross the line.
---
<script>
  (function() {
    const sections = Array.from(document.querySelectorAll("section[id]")) as HTMLElement[];
    if (sections.length === 0) return;

    let snapping = false;
    const SNAP_LOCK_MS = 1000;

    const snapTo = (target: HTMLElement) => {
      if (snapping) return;
      snapping = true;
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(() => { snapping = false; }, SNAP_LOCK_MS);
    };

    // Observe each section. When its top crosses the upper threshold (40% of viewport),
    // snap to it. Threshold: 0.6 means section is 60% visible before we trigger.
    const io = new IntersectionObserver(
      (entries) => {
        if (snapping) return;
        // Pick the entry whose top is closest to the snap line (top of viewport)
        let best: { target: HTMLElement; top: number } | null = null;
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const rect = e.boundingClientRect;
          if (best === null || Math.abs(rect.top) < Math.abs(best.top)) {
            best = { target: e.target as HTMLElement, top: rect.top };
          }
        }
        if (best && Math.abs(best.top) < 200) {
          snapTo(best.target);
        }
      },
      { threshold: [0.6, 0.8] }
    );

    sections.forEach((s) => io.observe(s));
  })();
</script>

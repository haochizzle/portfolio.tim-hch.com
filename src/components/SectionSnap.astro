---
// JS-driven snap — listens for wheel/touch and explicitly scrolls to next/prev section.
// Doesn't rely on CSS scroll-snap-type behavior (which varies by browser/Vercel env).
---
<script>
  (function() {
    const sections = Array.from(document.querySelectorAll("section[id]")) as HTMLElement[];
    if (sections.length === 0) return;

    let locked = false;
    const LOCK_MS = 900;

    const currentIndex = () => {
      const y = window.scrollY + window.innerHeight / 2;
      let best = 0;
      let bestDist = Infinity;
      sections.forEach((s, i) => {
        const center = s.offsetTop + s.offsetHeight / 2;
        const d = Math.abs(center - y);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      return best;
    };

    const scrollToIndex = (i: number) => {
      const target = sections[Math.max(0, Math.min(sections.length - 1, i))];
      if (!target) return;
      locked = true;
      target.scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(() => { locked = false; }, LOCK_MS);
    };

    // Wheel handler — accumulate delta, then snap to next/prev section
    let wheelAcc = 0;
    const WHEEL_THRESHOLD = 80;
    window.addEventListener("wheel", (e) => {
      if (locked) return;
      // Don't hijack wheel when it's clearly over an interactive element
      const t = e.target as HTMLElement | null;
      if (t?.closest(".carousel .track, .nav, .card-link, a, button, [data-embed-iframe]")) {
        // Allow carousel scroll / link clicks / button presses
        return;
      }
      wheelAcc += e.deltaY;
      if (Math.abs(wheelAcc) >= WHEEL_THRESHOLD) {
        const dir = wheelAcc > 0 ? 1 : -1;
        const idx = currentIndex();
        scrollToIndex(idx + dir);
        wheelAcc = 0;
      }
    }, { passive: true });

    // Touch handler — track vertical swipe distance
    let touchStartY: number | null = null;
    window.addEventListener("touchstart", (e) => {
      touchStartY = e.touches[0]?.clientY ?? null;
    }, { passive: true });
    window.addEventListener("touchend", (e) => {
      if (touchStartY == null || locked) return;
      const endY = e.changedTouches[0]?.clientY ?? touchStartY;
      const dy = touchStartY - endY;
      if (Math.abs(dy) > 50) {
        const dir = dy > 0 ? 1 : -1;
        const idx = currentIndex();
        scrollToIndex(idx + dir);
      }
      touchStartY = null;
    }, { passive: true });

    // Keyboard
    window.addEventListener("keydown", (e) => {
      if (locked) return;
      if (e.key === "ArrowDown" || e.key === "PageDown" || e.key === " ") {
        e.preventDefault();
        scrollToIndex(currentIndex() + 1);
      } else if (e.key === "ArrowUp" || e.key === "PageUp") {
        e.preventDefault();
        scrollToIndex(currentIndex() - 1);
      } else if (e.key === "Home") {
        scrollToIndex(0);
      } else if (e.key === "End") {
        scrollToIndex(sections.length - 1);
      }
    });
  })();
</script>
